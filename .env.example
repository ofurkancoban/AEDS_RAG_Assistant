# Copy this file to .env and fill in real values. .env is gitignored - never
# commit real secrets.

# LLM_PROVIDER selects the chat/classifier model: "ollama" (default, local,
# no key needed), "gemini", or "openrouter". Only the key for whichever
# provider you pick is actually required.
# LLM_PROVIDER=ollama

# Required when LLM_PROVIDER=gemini - get a key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required when LLM_PROVIDER=openrouter - get a key at
# https://openrouter.ai/keys. Pick a ":free" model (e.g.
# google/gemma-4-31b-it:free) to pay nothing - but note the free tier is
# capped at 20 requests/minute and only 50/day unless the account has ever
# purchased $10+ in credits (then 1000/day); check your own tier at
# https://openrouter.ai/api/v1/key. A chat turn spends 2-3 requests, so the
# no-credits tier covers roughly 15-25 real questions per day.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Required in production (environment=production) - any long random string.
# The app refuses to start in production with the placeholder default.
# JWT_SECRET=

# environment=production enables fail-fast startup checks (JWT secret, etc).
# ENVIRONMENT=development

# Optional - scripts/source_refresh.py posts to this bot/chat when a source
# page changed since the last nightly check. Leave both empty to skip
# notifications (the script still logs the finding either way).
# Create a bot via @BotFather to get TELEGRAM_BOT_TOKEN, then message the bot
# once and read https://api.telegram.org/bot<token>/getUpdates to find your
# chat id for TELEGRAM_CHAT_ID.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Optional - additional admin chats (comma-separated ids) that get the same
# review-queue notifications and admin command access as TELEGRAM_CHAT_ID.
# TELEGRAM_EXTRA_ADMIN_CHAT_IDS=

# Optional - encrypts the nightly app.db/chroma snapshots scripts/maintenance.py
# writes to data/backups/. Empty means backups are written unencrypted.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# BACKUP_ENCRYPTION_KEY=
